// Cloudflare Worker that relays Instagram reels to the app (see worker/worker.js).
// Only the worker script is deployed; the app itself is served by GitHub Pages.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipes",
  "main": "worker/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true
}
