// Cloudflare Worker that relays Instagram reels to the app (see worker/worker.js).
// Only the worker script is deployed; the app itself is served by GitHub Pages.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipes",
  "main": "worker/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Synced recipes. With no "id", `wrangler deploy` creates the namespace on the first deploy.
  "kv_namespaces": [{ "binding": "RECIPES" }]
}
